# syntax=docker/dockerfile:1
# =============================================================
# ISUFSTPASS - Vercel + FrankenPHP + Supabase PostgreSQL
# Build: vite (frontend) -> composer (vendor) -> frankenphp (runtime)
#
# Vercel contract:
#   - Dockerfile.vercel is auto-detected at project root
#   - container must open an HTTP server on $PORT (default 80)
#   - instance scales to zero when idle -> NO long-running
#     queue workers / schedulers inside this image. The daily
#     reminder job is triggered via Vercel Cron (see PART 9).
# =============================================================

# ---------- Stage 1: PHP dependencies (composer) ----------
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --no-progress \
    --no-scripts \
    --optimize-autoloader

# ---------- Stage 2: Frontend assets (vite) ----------
FROM node:22-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# ---------- Stage 3: FrankenPHP runtime ----------
FROM dunglas/frankenphp:1-php8.3 AS franken
LABEL "org.opencontainers.image.title"="isufstpass"
LABEL "org.opencontainers.image.description"="ISUFSTPASS - QR Code-Based Document Management System"

# PHP extensions required at runtime:
#   pdo_pgsql - Supabase PostgreSQL driver (pdo_mysql NOT needed in production)
#   gd        - QR logo rasterization (app/Support/QrPassCard.php)
RUN install-php-extensions pdo_pgsql gd

# ---------- Application ----------
WORKDIR /app

# Composer-managed dependencies (production, no dev)
COPY --from=vendor /app/vendor ./vendor
COPY composer.json composer.lock ./

# Application source (everything except .dockerignore excludes)
COPY . .

# Built vite assets
COPY --from=frontend /app/public/build ./public/build

# Storage layout + permissions (ephemeral on Vercel - avatars live in Supabase Storage/S3)
RUN mkdir -p storage/framework/sessions storage/framework/views storage/framework/cache/data \
             storage/framework/testing storage/logs bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache \
    && ln -sfn /app/storage/app/public /app/public/storage

# FrankenPHP (Caddy) config + boot script
COPY docker/Caddyfile /etc/caddy/Caddyfile
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# EXPOSE is documentation only - Vercel routes to $PORT (default 80)
EXPOSE 80

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]