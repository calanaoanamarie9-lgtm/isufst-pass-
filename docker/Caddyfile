# FrankenPHP / Caddy server config for ISUFSTPASS
# Listens on Vercel's $PORT (injected at runtime).
# TLS is terminated by Vercel's edge - no certs needed here.

{
	# Do not try to bind :443 or obtain certificates.
	auto_https off

	# Caddy admin endpoint not needed and is a security risk.
	admin off
}

:{$PORT:80} {
	# Serve the Laravel public directory as web root.
	root * /app/public

	# Express (PHP) handling: runs index.php and passes
	# non-existing static paths to Laravel's router.
	php_server

	# Compression
	encode zstd gzip

	# Security headers (Vercel edge adds its own too)
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header X-Frame-Options DENY
	header Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Laravel health check used by Vercel
	handle /up {
		root * /app/public
		php_server
	}
}